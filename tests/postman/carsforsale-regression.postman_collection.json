{
  "info": {
    "name": "Cars for Sale - Homepage Regression",
    "description": "Automated regression suite for https://carsforsell.ddev.site/ covering REG-01 to REG-10 from tests/regression/carsforsale-homepage-regression.csv.\n\nThe site runs locally on DDEV, so run this collection from the Postman desktop app (Collection Runner) or Newman on this machine. The Postman cloud runner cannot reach *.ddev.site.\n\nNot automated (manual checks): visual sticky-header behaviour while scrolling, keyboard focus order, the mobile layout, and submitting the purchase request form (it would create real leads).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://carsforsell.ddev.site" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('No Drupal error page', () => {",
          "  pm.expect(pm.response.text()).to.not.include('The website encountered an unexpected error');",
          "});",
          "pm.test('Response time under 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "REG-01: Homepage loads with default listing of all cars",
      "item": [
        {
          "name": "Homepage shows 10 complete car cards",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const cards = html.split('<article class=\"car-card').slice(1).map(c => c.split('</article>')[0]).map(c => {",
                  "  const t = c.match(/car-card__title\"><a href=\"([^\"]+)\">([^<]+)</) || [];",
                  "  const specs = [...c.matchAll(/<li>([^<]*)<\\/li>/g)].map(m => m[1].trim());",
                  "  const num = s => Number(String(s || '').replace(/[^0-9.]/g, ''));",
                  "  return { href: t[1], title: t[2], price: num((c.match(/car-card__price\">([^<]+)</) || [])[1]), location: (c.match(/car-card__location\">([^<]+)</) || [])[1], year: Number(specs[0]), mileage: num(specs[1]), fuel: specs[2], transmission: specs[3], cta: (c.match(/<a href=\"([^\"]+)\" class=\"button car-card__cta\">View (&|&amp;) buy/) || [])[1], photos: c.includes('car-card__photos\">2 photos') };",
                  "});",
                  "const count = Number((html.match(/(\\d+) cars? found/) || [])[1]);",
                  "",
                  "pm.test('Status is 200 HTML', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "pm.test('Page title and H1', () => {",
                  "  pm.expect(html).to.include('<title>Cars for sale | Cars for Sale</title>');",
                  "  pm.expect(html).to.match(/<h1[^>]*>\\s*Cars for sale\\s*<\\/h1>/);",
                  "});",
                  "pm.test('Shows 10 cars found and 10 cards', () => {",
                  "  pm.expect(count).to.eql(10);",
                  "  pm.expect(cards.length).to.eql(10);",
                  "});",
                  "pm.test('Default sort is Newest listings', () => {",
                  "  pm.expect(html).to.include('<option value=\"newest\" selected>');",
                  "});",
                  "pm.test('Every card has title, price, location, year, mileage, fuel, transmission, photos label and View & buy', () => {",
                  "  cards.forEach(c => {",
                  "    pm.expect(c.title, 'title').to.be.a('string').and.not.empty;",
                  "    pm.expect(c.price, c.title + ' price').to.be.above(0);",
                  "    pm.expect(c.location, c.title + ' location').to.be.oneOf(['Downtown Showroom', 'Northside Lot', 'Airport Road Center']);",
                  "    pm.expect(c.year, c.title + ' year').to.be.within(1990, 2100);",
                  "    pm.expect(c.mileage, c.title + ' mileage').to.be.at.least(0);",
                  "    pm.expect(c.fuel, c.title + ' fuel').to.be.oneOf(['Gasoline', 'Diesel', 'Hybrid', 'Plug-in hybrid', 'Electric']);",
                  "    pm.expect(c.transmission, c.title + ' transmission').to.be.a('string').and.not.empty;",
                  "    pm.expect(c.photos, c.title + ' photos label').to.be.true;",
                  "    pm.expect(c.cta, c.title + ' View & buy link').to.eql(c.href);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" }
        },
        {
          "name": "Browse cars page (/cars) shows the same 10 cars",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('10 cars found', () => pm.expect(html).to.match(/\\b10 cars found/));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/cars" }
        }
      ]
    },
