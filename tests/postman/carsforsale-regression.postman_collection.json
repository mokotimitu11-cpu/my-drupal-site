                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Image, title and View & buy all link to the same car page', () => {",
                  "  pm.expect(cards.length).to.eql(10);",
                  "  cards.forEach(c => {",
                  "    pm.expect(c.links, c.title).to.have.lengthOf(1);",
                  "    pm.expect(c.links[0], c.title).to.match(/^\\/node\\/\\d+$/);",
