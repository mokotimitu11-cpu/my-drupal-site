                  "  price: (c.match(/car-card__price\">([^<]+)</) || [])[1],",
                  "  location: (c.match(/car-card__location\">([^<]+)</) || [])[1],",
                  "  links: [...new Set([...c.matchAll(/<a href=\"([^\"]+)\"/g)].map(m => m[1]))]",
