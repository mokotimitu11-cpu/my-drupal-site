                  "});",
                  "pm.collectionVariables.set('carUrl', cards[0].links[0]);",
                  "pm.collectionVariables.set('carTitle', cards[0].title);",
                  "pm.collectionVariables.set('carPrice', cards[0].price);",
                  "pm.collectionVariables.set('carLocation', cards[0].location);",
                  "pm.collectionVariables.set('allCars', JSON.stringify(cards.map(c => ({ title: c.title, url: c.links[0] }))));"
